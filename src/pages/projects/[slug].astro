---
import Site from '../../layouts/Site.astro';
import Ridge from '../../components/Ridge.astro';
import { getProjects, kindLabels, formatMonth, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: projects[i - 1] ?? null, next: projects[i + 1] ?? null, all: projects },
  }));
}

const { project: p, prev, next, all } = Astro.props as { project: Project; prev: Project | null; next: Project | null; all: Project[] };
const [hero, ...rest] = p.screenshots;
const seriesNext = p.series
  ? all.find((o) => o.series === p.series && o.seriesPart === (p.seriesPart ?? 0) + 1)
  : undefined;
---
<Site title={p.title} current="projects" description={p.summary}>
  <section class="layer-1">
    <div class="wrap intro">
      <nav aria-label="Breadcrumb" class="mono crumbs">
        <a href="/projects">Projects</a> <span aria-hidden="true">/</span> <span aria-current="page">{p.title}</span>
      </nav>
      <div class="head">
        <div class="title">
          <p class="mono eyebrow">{kindLabels[p.kind]} · {p.year} · {p.status}</p>
          <h1>{p.title}</h1>
        </div>
        <p class="lead">{p.summary}</p>
      </div>
      {p.series && p.seriesPart && (
        <p class="series">
          Part {p.seriesPart}{p.seriesTotal ? ` of ${p.seriesTotal}` : ''} in <strong>{p.series}</strong>.
          {seriesNext && <> Next: <a href={`/projects/${seriesNext.slug}`}>{seriesNext.title}</a></>}
        </p>
      )}
    </div>
  </section>

  <Ridge color="var(--layer-2)" variant={1} />
  <section class="layer-2" aria-label="Project facts">
    <div class="wrap facts">
      <dl>
        {p.stack && <div><dt class="mono">Stack</dt><dd>{p.stack}</dd></div>}
        {p.role && <div><dt class="mono">Role</dt><dd>{p.role}</dd></div>}
        {p.started && <div><dt class="mono">Started</dt><dd>{formatMonth(p.started)}</dd></div>}
        {p.status && <div><dt class="mono">Status</dt><dd>{p.status}</dd></div>}
      </dl>
      <div class="actions">
        {p.github && <a class="btn btn-solid" href={p.github}>View the code</a>}
        {p.live && <a class="btn btn-outline" href={p.live}>Open the site</a>}
        {p.build && <a class="btn btn-outline" href={`/builds/${p.build}`}>Read the build log</a>}
      </div>
    </div>
  </section>

  {hero && (
    <>
      <Ridge color="var(--layer-3)" variant={2} />
      <section class="layer-3" aria-label="Screenshots">
        <div class="wrap band">
          <figure class="hero">
            <img src={hero.src} alt={hero.caption || `Screenshot of ${p.title}`} />
            {hero.caption && <figcaption>{hero.caption}</figcaption>}
          </figure>
          {rest.length > 0 && (
            <div class="shots">
              {rest.map((s) => (
                <figure>
                  <img src={s.src} alt={s.caption || `Screenshot of ${p.title}`} loading="lazy" />
                  {s.caption && <figcaption>{s.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}
        </div>
      </section>
    </>
  )}

  <Ridge color="var(--layer-4)" variant={3} />
  <article class="layer-4" aria-label="Write-up">
    <div class="wrap band">
      <div class="prose" set:html={p.html} />
    </div>
  </article>

  <Ridge color="var(--layer-5)" variant={1} />
  <nav class="layer-5" aria-label="More projects">
    <div class="wrap more">
      {prev ? <a class="pn" href={`/projects/${prev.slug}`}><span class="mono">Previous project</span><span class="t">← {prev.title}</span></a> : <span></span>}
      <a class="btn btn-outline" href="/projects">All projects</a>
      {next ? <a class="pn right" href={`/projects/${next.slug}`}><span class="mono">Next project</span><span class="t">{next.title} →</span></a> : <span></span>}
    </div>
  </nav>
</Site>

<style>
  .layer-1 { background: var(--layer-1); }
  .layer-2 { background: var(--layer-2); }
  .layer-3 { background: var(--layer-3); }
  .layer-4 { background: var(--layer-4); }
  .layer-5 { background: var(--layer-5); }
  .intro { padding-block: 32px clamp(64px, 8vw, 104px); }
  .crumbs { font-size: var(--text-meta); color: var(--muted); }
  .crumbs a { min-height: var(--tap); display: inline-flex; align-items: center; }
  .head { margin-top: clamp(32px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-end; justify-content: space-between; }
  .title { flex: 1 1 520px; min-width: 0; }
  h1 { font-size: clamp(36px, 5vw, 64px); line-height: 1.05; }
  .eyebrow { font-size: var(--text-meta); color: var(--muted); margin: 0 0 14px; }
  .lead { flex: 0 1 380px; margin: 0; font-size: var(--text-lead); line-height: 1.5; color: var(--muted); }
  .series { margin: 28px 0 0; padding: 12px 16px; border-left: 2px solid var(--burgundy-light); background: rgba(230, 223, 208, 0.05); font-size: var(--text-small); }
  .series strong { font-weight: 600; }

  .facts { padding-block: 48px 64px; display: flex; flex-wrap: wrap; gap: 32px 48px; align-items: center; justify-content: space-between; }
  dl { margin: 0; display: flex; flex-wrap: wrap; gap: 24px 56px; }
  dt { font-size: 13px; color: var(--muted); }
  dd { margin: 4px 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .band { padding-block: 64px 88px; }
  figure { margin: 0; }
  figure img { width: 100%; height: auto; display: block; border-radius: var(--radius); }
  figcaption { margin-top: 10px; font-style: italic; font-size: var(--text-caption); color: var(--muted); }
  .shots { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 24px; }
  .shots figure { flex: 1 1 320px; min-width: 0; }
  .shots img { height: 260px; object-fit: cover; object-position: top; }

  .prose { max-width: 680px; margin: 0 auto; }
  .prose :global(h2) { font-size: clamp(24px, 2.6vw, 32px); margin: 48px 0 16px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0 0 1em; }
  .prose :global(pre) { font-family: var(--font-mono); background: var(--ink); padding: 20px 22px; border-radius: var(--radius); font-size: 15px; line-height: 1.6; overflow-x: auto; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.85em; }

  .more { padding-block: 48px 56px; display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; }
  .pn { text-decoration: none; min-height: var(--tap); display: flex; flex-direction: column; justify-content: center; }
  .pn.right { text-align: right; }
  .pn .mono { font-size: 13px; color: var(--muted); }
  .pn .t { font-family: var(--font-heading); font-weight: 600; font-size: var(--text-h3); letter-spacing: 0.03em; }
</style>
