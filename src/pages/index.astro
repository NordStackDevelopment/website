---
import Site from '../layouts/Site.astro';
import Ridge from '../components/Ridge.astro';
import WorkFilter from '../components/WorkFilter.astro';
import LayerStack from '../components/LayerStack.astro';
import { getCurrentBuild, getWork, getHomePhotos, getSettings, formatDate } from '../lib/content';

const build = await getCurrentBuild();
const work = await getWork();
const photos = await getHomePhotos();
const settings = await getSettings();
---
<Site>
  <section class="layer-1">
    <div class="wrap hero">
      <h1>Building from the ground up</h1>
      <p class="lead">Projects, builds and photographs, laid down one layer at a time.</p>
    </div>
  </section>

  {build && (
    <>
      <Ridge color="var(--layer-2)" variant={1} />
      <section class="layer-2" aria-labelledby="now-h">
        <div class="wrap band now">
          <div class="now-text">
            <p class="mono kicker">Now building · updated {formatDate(build.updated)}</p>
            <h2 id="now-h">{build.title}</h2>
            <p class="summary">{build.summary}</p>
            <a class="btn btn-solid" href={`/builds/${build.slug}`}>Read the build log</a>
          </div>
          <div class="stack"><LayerStack layers={build.layers} /></div>
        </div>
      </section>
    </>
  )}

  <Ridge color="var(--layer-3)" variant={2} />
  <section id="work" class="layer-3" aria-labelledby="work-h">
    <div class="wrap band">
      <WorkFilter items={work} />
    </div>
  </section>

  <Ridge color="var(--layer-4)" variant={3} />
  <section id="photos" class="layer-4" aria-labelledby="photos-h">
    <div class="wrap band">
      <h2 id="photos-h" class="photos-h">Photographs</h2>
      <div class="photos">
        {photos.map((p) => (
          <figure class:list={{ wide: p.wide }}>
            {p.src
              ? <img src={p.src} alt={p.alt} loading="lazy" />
              : <div class="ph" role="img" aria-label={p.alt}></div>}
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
      <a class="btn btn-outline more" href="/photos">All photographs</a>
    </div>
  </section>

  <Ridge color="var(--layer-5)" variant={4} />
  <section id="about" class="layer-5" aria-labelledby="about-h">
    <div class="wrap band about">
      <h2 id="about-h">Made up north, one layer at a time</h2>
      <p>{settings.about_short}</p>
    </div>
  </section>
</Site>

<style>
  .layer-1 { background: var(--layer-1); }
  .layer-2 { background: var(--layer-2); }
  .layer-3 { background: var(--layer-3); }
  .layer-4 { background: var(--layer-4); }
  .layer-5 { background: var(--layer-5); }

  .hero {
    padding-block: clamp(64px, 9vw, 128px) clamp(72px, 9vw, 120px);
    display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end; justify-content: space-between;
  }
  .hero h1 { flex: 1 1 560px; min-width: 0; }
  .lead { flex: 0 1 340px; margin: 0; font-size: var(--text-lead); line-height: 1.5; color: var(--muted); }

  .band { padding-block: 72px 96px; }

  .now { display: flex; flex-wrap: wrap; gap: 48px; }
  .now-text { flex: 1 1 420px; min-width: 0; }
  .kicker { margin: 0 0 14px; font-size: var(--text-meta); color: var(--muted); }
  .summary { margin: 16px 0 28px; max-width: 46ch; }
  .stack { flex: 1 1 380px; min-width: 0; }

  .photos-h { margin-bottom: 32px; }
  .photos { display: flex; flex-wrap: wrap; gap: 16px; }
  figure { flex: 1 1 240px; min-width: 0; margin: 0; }
  figure.wide { flex: 2 1 420px; }
  figure .ph, figure img { height: 380px; width: 100%; object-fit: cover; display: block; }
  figcaption { margin-top: 10px; font-style: italic; font-size: var(--text-caption); color: var(--muted); }
  .more { margin-top: 28px; }

  .about { padding-bottom: 88px; display: flex; flex-wrap: wrap; gap: 32px 80px; }
  .about h2 { flex: 0 1 380px; }
  .about p { flex: 1 1 380px; min-width: 0; margin: 0; max-width: 60ch; }
</style>
