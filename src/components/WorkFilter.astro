---
// Work section with the All / Projects / Builds / Photos filter.
// Without JavaScript every card shows; the script adds filtering.
import type { WorkItem } from '../lib/content';

interface Props { items: WorkItem[] }
const { items } = Astro.props;
const segments = [
  ['all', 'All'], ['project', 'Projects'], ['build', 'Builds'], ['photo', 'Photos'],
] as const;
---
<div class="head">
  <h2 id="work-h">Work</h2>
  <div role="group" aria-label="Filter work" class="seg" data-work-filter>
    {segments.map(([id, label]) => (
      <button type="button" data-kind={id} aria-pressed={id === 'all' ? 'true' : 'false'}>{label}</button>
    ))}
  </div>
</div>
<p class="sr-status" role="status" data-work-status></p>
<div class="cards">
  {items.map((it) => (
    <a href={it.href} class="card" data-kind={it.kind}>
      <div class="ph" role="img" aria-label="Image placeholder"></div>
      <div class="body">
        <p class="mono meta">{it.meta}</p>
        <h3>{it.title}</h3>
        <p class="line">{it.line}</p>
      </div>
    </a>
  ))}
</div>

<script>
  for (const group of document.querySelectorAll<HTMLElement>('[data-work-filter]')) {
    const section = group.closest('section');
    if (!section) continue;
    const cards = section.querySelectorAll<HTMLElement>('.card');
    const status = section.querySelector<HTMLElement>('[data-work-status]');
    group.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-kind]');
      if (!btn) return;
      const kind = btn.dataset.kind;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      cards.forEach((c) => {
        const show = kind === 'all' || c.dataset.kind === kind;
        c.hidden = !show;
        if (show) shown++;
      });
      if (status) status.textContent = `Showing ${shown} of ${cards.length}`;
    });
  }
</script>

<style>
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  .seg {
    display: flex; flex-wrap: wrap; gap: 2px; padding: 3px;
    background: var(--ink); border: 1px solid var(--muted); border-radius: 10px;
  }
  .seg button {
    border: 0; border-radius: 8px; min-height: var(--tap); min-width: 88px; padding: 0 16px;
    font-size: var(--text-small); background: transparent; color: var(--bone);
  }
  .seg button[aria-pressed='true'] { background: var(--bone); color: var(--green); }
  .sr-status {
    position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
  }
  .cards { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 32px; }
  .card {
    flex: 1 1 260px; min-width: 0; max-width: 100%;
    background: var(--ink); border: 1px solid var(--card-border); border-radius: var(--radius);
    text-decoration: none; display: flex; flex-direction: column; overflow: hidden;
  }
  .card[hidden] { display: none; }
  .card .ph { height: 168px; }
  .body { padding: 20px 22px 24px; }
  .meta { margin: 0; font-size: 13px; color: var(--muted); }
  .card h3 { margin: 8px 0 6px; }
  .line { margin: 0; font-size: var(--text-small); line-height: 1.5; }
</style>
